# GrievancePulse AI — Environment Setup
# Copy this file to .env in the server/ directory and fill in your credentials.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROK_API_KEY=
GROK_MODEL=grok-2-latest
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GrievancePulseAI/1.0 (contact: your-email@example.com)
PORT=3001
NODE_ENV=development
# Optional override; defaults to server/data/grievances.sqlite
GRIEVANCE_DB_PATH=
